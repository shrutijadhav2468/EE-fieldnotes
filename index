  <script>

    // ---------------------------------
    // 1. GET HTML ELEMENTS
    // ---------------------------------

    const angleSlider = document.getElementById("angleSlider");
    const angleValue = document.getElementById("angleValue");

    const inputWave = document.getElementById("inputWave");
    const outputWave = document.getElementById("outputWave");

    const angleMarker = document.getElementById("angleMarker");
    const angleText = document.getElementById("angleText");

    const playButton = document.getElementById("playButton");

    const previousButton = document.getElementById("previousStep");
    const nextButton = document.getElementById("nextStep");

    const stepInfo = document.getElementById("stepInfo");


    // ---------------------------------
    // 2. ANIMATION STATE
    // ---------------------------------

    let currentStep = 0;
    let animationTimer = null;

    const steps = [

      {
        title: "Observe the input",
        description:
          "The dashed curve represents the sinusoidal input voltage."
      },

      {
        title: "Firing angle",
        description:
          "The firing angle α determines when the controlled device begins conducting in this illustrative model."
      },

      {
        title: "Output waveform",
        description:
          "Observe how changing α changes the illustrated output waveform."
      },

      {
        title: "Explore",
        description:
          "Move the slider and compare how different firing angles affect the waveform."
      }

    ];


    // ---------------------------------
    // 3. GENERATE THE INPUT SINE WAVE
    // ---------------------------------

    function generateInputWave() {

      let path = "";

      for (let x = 20; x <= 320; x += 2) {

        const angle = ((x - 20) / 300) * Math.PI * 2;

        const y = 90 - 55 * Math.sin(angle);

        if (x === 20) {

          path += `M ${x} ${y}`;

        } else {

          path += ` L ${x} ${y}`;

        }

      }

      inputWave.setAttribute("d", path);

    }


    // ---------------------------------
    // 4. GENERATE OUTPUT WAVEFORM
    // ---------------------------------

    function generateOutputWave(alpha) {

      let path = "";

      const alphaRadians = alpha * Math.PI / 180;

      for (let x = 20; x <= 320; x += 2) {

        const angle = ((x - 20) / 300) * Math.PI * 2;

        const localAngle = angle % Math.PI;

        const conducting = localAngle >= alphaRadians;

        let y = 90;

        if (conducting) {

          y = 90 - 55 * Math.abs(Math.sin(angle));

        }

        if (x === 20) {

          path += `M ${x} ${y}`;

        } else {

          path += ` L ${x} ${y}`;

        }

      }

      outputWave.setAttribute("d", path);

    }


    // ---------------------------------
    // 5. UPDATE FIRING ANGLE
    // ---------------------------------

    function updateAngle() {

      const alpha = Number(angleSlider.value);

      angleValue.textContent = `${alpha}°`;

      const markerX = 20 + (alpha / 180) * 150;

      angleMarker.setAttribute("x1", markerX);
      angleMarker.setAttribute("x2", markerX);

      angleText.setAttribute("x", markerX + 5);

      angleText.textContent = `α = ${alpha}°`;

      generateOutputWave(alpha);

    }


    // ---------------------------------
    // 6. UPDATE GUIDED ANIMATION
    // ---------------------------------

    function updateStep() {

      const step = steps[currentStep];

      stepInfo.innerHTML =
        `<strong>Step ${currentStep + 1}: ${step.title}.</strong> ` +
        step.description;

    }


    function next() {

      currentStep = (currentStep + 1) % steps.length;

      updateStep();

    }


    function previous() {

      currentStep =
        (currentStep - 1 + steps.length) % steps.length;

      updateStep();

    }


    // ---------------------------------
    // 7. PLAY / PAUSE
    // ---------------------------------

    function toggleAnimation() {

      if (animationTimer) {

        clearInterval(animationTimer);

        animationTimer = null;

        playButton.textContent = "▶ Play";

        return;

      }

      playButton.textContent = "Ⅱ Pause";

      animationTimer = setInterval(() => {

        next();

      }, 2200);

    }


    // ---------------------------------
    // 8. EVENT LISTENERS
    // ---------------------------------

    angleSlider.addEventListener("input", updateAngle);

    nextButton.addEventListener("click", next);

    previousButton.addEventListener("click", previous);

    playButton.addEventListener("click", toggleAnimation);


    // ---------------------------------
    // 9. INITIALIZE THE DEMO
    // ---------------------------------

    generateInputWave();

    updateAngle();

    updateStep();

  </script>

